generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CLIENT
  ADMIN
}

model User {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String    @db.VarChar(120)
  email     String    @unique @db.VarChar(160)
  mobileNumber String? @map("mobile_number") @db.VarChar(20)
  password  String    @db.VarChar(255)
  role                 Role      @default(CLIENT)
  resetPasswordToken   String?   @map("reset_password_token") @db.VarChar(255)
  resetPasswordExpires DateTime? @map("reset_password_expires")
  mfaSecret            String?   @map("mfa_secret") @db.VarChar(255)
  mfaEnabled           Boolean   @default(false) @map("mfa_enabled")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at")
  account              Account?

  @@map("users")
}

model Account {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String        @unique @map("user_id") @db.Uuid
  accountNumber String        @unique @map("account_number") @db.VarChar(20)
  balance       Decimal       @db.Decimal(19, 4)
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @default(now()) @updatedAt @map("updated_at")
  
  user          User          @relation(fields: [userId], references: [id])
  sentTransfers Transaction[] @relation("SentTransfers")
  recvTransfers Transaction[] @relation("ReceivedTransfers")

  @@map("accounts")
}

model Transaction {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  referenceId   String   @unique @map("reference_id") @db.VarChar(64)
  fromAccountId String   @map("from_account_id") @db.Uuid
  toAccountId   String   @map("to_account_id") @db.Uuid
  amount        Decimal  @db.Decimal(19, 4)
  status        String   @db.VarChar(20)
  description   String?  @db.VarChar(255)
  otpCode       String?  @map("otp_code") @db.VarChar(6)
  otpExpiresAt  DateTime? @map("otp_expires_at")
  createdAt     DateTime @default(now()) @map("created_at")

  fromAccount Account @relation("SentTransfers", fields: [fromAccountId], references: [id])
  toAccount   Account @relation("ReceivedTransfers", fields: [toAccountId], references: [id])

  @@index([fromAccountId])
  @@index([toAccountId])
  @@index([createdAt])
  @@map("transactions")
}
