{
  "version": 2,
  "builds": [
    {
      "src": "server/api/index.ts",
      "use": "@vercel/node"
    },
    {
      "src": "client/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/server/api/index.ts"
    },
    {
      "source": "/assets/(.*)",
      "destination": "/client/assets/$1"
    },
    {
      "source": "/favicon.svg",
      "destination": "/client/favicon.svg"
    },
    {
      "source": "/icons.svg",
      "destination": "/client/icons.svg"
    },
    {
      "source": "/(.*)",
      "destination": "/client/index.html"
    }
  ]
}
